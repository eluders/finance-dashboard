{
  "manifest_version": 3,
  "name": "Finance Dashboard",
  "version": "0.1.0",
  "description": "Reads statement pages only when you click; stores data in your private GitHub repo.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["https://api.github.com/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "action": { "default_popup": "src/popup/popup.html", "default_title": "Finance Dashboard" },
  "options_page": "src/options/options.html"
}
